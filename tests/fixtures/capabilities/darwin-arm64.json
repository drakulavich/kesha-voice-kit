    },
    {
      "code": "E_ENGINE_SPAWN",
      "title": "Engine binary not installed or failed to start",
      "category": "platform",
      "retryable": false,
      "origin": "cli"
    },
    {
      "code": "E_ENGINE_PROTOCOL",
      "title": "Engine speaks a protocol this CLI does not",
      "category": "platform",
      "retryable": false,
      "origin": "cli"
    },
    {
      "code": "E_INSTALL_RACE",
      "title": "Another install reached the same cache first",
      "category": "internal",
      "retryable": true,
      "origin": "cli"
    }
  ],
  "warnings": [
    {
      "code": "W_VAD_NOT_INSTALLED",
