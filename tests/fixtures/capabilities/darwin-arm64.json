    {
      "code": "E_SCRIPT_UNSUPPORTED",
      "title": "Text script not supported for this voice",
      "category": "tts",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_TRANSCRIBE_FAILED",
      "title": "Transcription failed",
      "category": "transcribe",
