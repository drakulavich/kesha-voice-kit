{
  "protocolVersion": 4,
  "backend": "coreml",
  "profile": "darwin",
  "commands": {
    "describe": {
      "flags": {}
    },
    "detect-lang": {
      "flags": {}
    },
    "detect-text-lang": {
      "flags": {}
    },
    "install": {
      "flags": {
        "diarize": {
          "gate": "transcribe.diarize"
        },
        "no-cache": {
          "gate": null
        },
        "no-warmup": {
          "gate": null
        },
        "tts": {
          "gate": "tts",
          "values": "langs"
        },
        "vad": {
          "gate": null
        }
      }
    },
    "record": {
      "flags": {
        "auto-stop": {
          "gate": "record.live.auto-stop",
          "requires": [
            "live"
          ]
        },
        "auto-stop-min-speech-ms": {
          "gate": "record.live.auto-stop",
          "requires": [
            "auto-stop"
          ]
        },
        "auto-stop-silence-ms": {
          "gate": "record.live.auto-stop",
          "requires": [
            "auto-stop"
          ]
        },
        "auto-stop-threshold": {
          "gate": "record.live.auto-stop",
          "requires": [
            "auto-stop"
          ]
        },
        "live": {
          "gate": "record.live"
        },
        "max-seconds": {
          "gate": null
        },
        "out": {
          "gate": null,
          "conflicts": [
            "live"
          ]
        }
      }
    },
    "say": {
      "flags": {
        "bitrate": {
          "gate": "tts"
        },
        "format": {
          "gate": "tts"
        },
        "lang": {
          "gate": "tts"
        },
        "list-voices": {
          "gate": "tts"
        },
        "model": {
          "gate": "tts",
          "requires": [
            "voice-file"
          ]
        },
        "no-expand-abbrev": {
          "gate": [
            "tts.ru_acronym_expansion",
            "tts.en_acronym_expansion"
          ],
          "whenUngated": "drop"
        },
        "out": {
          "gate": "tts"
        },
        "rate": {
          "gate": "tts.prosody_rate"
        },
        "sample-rate": {
          "gate": "tts"
        },
        "ssml": {
          "gate": "tts"
        },
        "stdin-loop": {
          "gate": "tts"
        },
        "voice": {
          "gate": "tts"
        },
        "voice-file": {
          "gate": "tts",
          "requires": [
            "model"
          ]
        }
      }
    },
    "transcribe": {
      "flags": {
        "itn": {
          "gate": "transcribe.itn"
        },
        "json": {
          "gate": null
        },
        "no-vad": {
          "gate": null,
          "conflicts": [
            "vad"
          ]
        },
        "speakers": {
          "gate": "transcribe.diarize",
          "requires": [
            "json"
          ],
          "conflicts": [
            "no-vad"
          ]
        },
        "vad": {
          "gate": null,
          "conflicts": [
            "no-vad"
          ]
        }
      }
    }
  },
  "features": [
    "transcribe",
    "transcribe.segments",
    "transcribe.itn",
    "detect-lang",
    "vad",
    "detect-text-lang",
    "record.live",
    "record.live.auto-stop",
    "tts",
    "tts.ru_acronym_expansion",
    "tts.en_acronym_expansion",
    "tts.ru_emphasis_marker",
    "tts.prosody_rate",
    "transcribe.diarize",
    "transcribe.words"
  ],
  "errors": [
    {
      "code": "E_INPUT_NOT_FOUND",
      "title": "Input file not found",
      "category": "input",
      "retryable": false,
      "origin": "both"
    },
    {
      "code": "E_BAD_AUDIO",
      "title": "Unreadable or unsupported audio",
      "category": "input",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_MODEL_MISSING",
      "title": "Model or voice not installed",
      "category": "model",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_MODEL_DOWNLOAD",
      "title": "Model download failed",
      "category": "model",
      "retryable": true,
      "origin": "engine"
    },
    {
      "code": "E_CACHE_CORRUPT",
      "title": "Cached model failed verification",
      "category": "model",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_MODEL_LOAD",
      "title": "Model failed to load",
      "category": "model",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_UNSUPPORTED_PLATFORM",
