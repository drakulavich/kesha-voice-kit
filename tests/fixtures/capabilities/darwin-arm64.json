    {
      "code": "E_TEXT_TOO_LONG",
      "title": "Synthesis text too long",
      "category": "tts",
      "retryable": false,
      "origin": "engine"
    },
    {
      "code": "E_VOICE_UNKNOWN",
      "title": "Unknown voice id",
